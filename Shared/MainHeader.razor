@using CharacomOnline.Service
@using CharacomOnline.Service.TableService
@using CharacomOnline.Components
@using CharacomOnline.Enums
@using CharacomOnline.ViewModel
@using Blazored.LocalStorage
@using System.ComponentModel

@inject LocalStorageService localStorage
@inject SessionStorageService SessionStorage
@inject OAuthService OAuthService
@inject Supabase.Client SupabaseClient
@inject NavigationManager NavigationManager
@inject ProjectsViewModel ProjectsViewModel
@inject UsersViewModel UsersViewModel
@inject NotificationsTableService NotificationsTableService
@inject AppState AppState
@inject LoginService LoginService

<RadzenHeader>
	<RadzenRow AlignItems="AlignItems.Center" Gap="1">
		<RadzenColumn>
			<RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center"
				JustifyContent="JustifyContent.Start" Gap="2px">
				<RadzenSidebarToggle Click="@ChangeExpand" />
				<RadzenText Style="padding-top: 10px;" TextStyle="TextStyle.H5">Characom Imapger Pro Online</RadzenText>
			</RadzenStack>
		</RadzenColumn>
		<RadzenColumn>
			<RadzenButton Click="@DebugPrint">Debug</RadzenButton>
		</RadzenColumn>
		<RadzenColumn>
			<RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center"
				JustifyContent="JustifyContent.Center">
				<RadzenText Style="padding-top: 10px;" TextStyle="TextStyle.Subtitle1">@AppState.AppStateData.ProjectName
				</RadzenText>
			</RadzenStack>
		</RadzenColumn>
		<RadzenColumn>
			<RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.End"
				Style="padding-right: 1rem;">
				<RadzenAppearanceToggle />
				<RadzenSidebarToggle Click="@ChangePanelExpand" Icon="notifications" />
				<ProfileMenu 
					UserName="@AppState.AppStateData.UserName"
					UserPict="@AppState.AppStateData.UserPictureUrl"
					ProjectName="@AppState.AppStateData.ProjectName"
					UserRole="@AppState.AppStateData.UserRole"
					IsAppLogin="@AppState.AppStateData.IsAppLogin"
					IsBoxLogin="@AppState.AppStateData.IsBoxLogin"
					Logout="Logout" 
				/>
			</RadzenStack>
		</RadzenColumn>
	</RadzenRow>
</RadzenHeader>

@code {
	[Parameter]
	public bool SidebarExpanded { get; set; } = true;
	[Parameter]
	public bool PanelExpanded { get; set; } = false;

	// 変更イベントのためのEventCallbackプロパティ
	[Parameter]
	public EventCallback<bool> SidebarExpandedChanged { get; set; }
	[Parameter]
	public EventCallback<bool> PanelExpandedChanged { get; set; }

	private PropertyChangedEventHandler? appStateHandler;
	private string? userPictureUrl;
	private string? userName;
	private bool isBoxLogin = false;
	private bool isDBLogin = false;
	private Guid? currentProjectId;
	private string? currentProjectName;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender) return;
		Console.WriteLine($"[Header]始めますよ。{NavigationManager.Uri.ToString()}");
		if (NavigationManager.Uri.Contains("/login") || NavigationManager.Uri.Contains("/callback"))
			return;

		// AppStateがあるかどうかの確認
		if (string.IsNullOrEmpty(AppState.AppStateData.UserId.ToString()))
		{
			// もし存在しなければLocalStorageからGet!
			var tmpState = await localStorage.LoadAppStateAsync();
			if (tmpState != null)
				AppState.AppStateData = tmpState; 
		}

		// AppStateをチェックして、まだないようであれば、loginへ誘導
		if (string.IsNullOrEmpty(AppState.AppStateData.UserId.ToString()))
		{
			NavigationManager.NavigateTo("/login", true);
			return;
		}

		// AppStateが存在したら、Supabaseにログインしているかどうかのチェック
		// ログインしてなければデバッグ文を出してログイン
		if (LoginService.IsSupabaseLoggedIn())
		{
			Console.WriteLine("[Header] Supabaseにログインしていないのでログインしなおします。");
			if (AppState.AppStateData.SupabaseAccessToken == null || AppState.AppStateData.SupabaseRefreshToken == null ){
				Console.WriteLine("[Header] AccessTokenまたはRefreshTokenが見つかりませんでした");
				NavigationManager.NavigateTo("/login", true);
				return;
			}
			var isReLogin = await LoginService.TryRestoreLoginAsync(AppState.AppStateData.SupabaseAccessToken, AppState.AppStateData.SupabaseRefreshToken);
			if (!isReLogin) {
				Console.WriteLine("[Header] リフレッシュログインできませんでした");
				NavigationManager.NavigateTo("/login", true);
				return;
			}
		}

		//ログインできたのでAppStateを表示
		Console.WriteLine($"[Header] ログインできたと思います AppState={AppState.AppStateData.ToString()}");


		Console.WriteLine($"Headerのレンダリング appState={AppState.AppStateData.ToString()}");

		await UsersViewModel.SetUserInfoToAppState();
		Console.WriteLine($"[Header] userName = {AppState.AppStateData.UserName}");
		//userPictureUrl = AppState.AppStateData.UserPictureUrl;
		//if (string.IsNullOrEmpty(userPictureUrl))
		//{
		//	userPictureUrl = "/images/no_user_icon.png";
		//}
		//userName = AppState.AppStateData.UserName;
		isBoxLogin = OAuthService.IsLogin();
		isDBLogin = AppState.AppStateData.IsAppLogin;
		//currentProjectId = AppState.AppStateData.ProjectId;
		//currentProjectName = AppState.AppStateData.ProjectName;

		await InvokeAsync(StateHasChanged);
	}

	private async Task DebugPrint()
	{
		Console.WriteLine($"Debug1 AppState = {AppState.AppStateData.ToString()}");
		var result = await localStorage.LoadAppStateAsync();
		Console.WriteLine($"Debug2 AppState = {result.ToString()}");
		if (LoginService == null) return;
		var isLogin = LoginService.IsSupabaseLoggedIn();
		Console.WriteLine($"Supabase Login ? = {isLogin}");
	}
	private async Task ChangeExpand()
	{
		bool newValue = !SidebarExpanded;
		await SidebarExpandedChanged.InvokeAsync(newValue); // 親に新しい値を送信
	}

	private async Task ChangePanelExpand()
	{
		bool newValue = !PanelExpanded;
		await PanelExpandedChanged.InvokeAsync(newValue); // 親に新しい値を送信
	}
	private async Task Logout(ProfileMenuItemType menu)
	{
		Console.WriteLine($"Logout {menu}");
		if (menu == ProfileMenuItemType.DBLogout || menu == ProfileMenuItemType.Exit)
		{
			try
			{
				// Supabaseセッションをクリア
				await SupabaseClient.Auth.SignOut();

				// ローカルストレージのトークンを削除
				//await localStorage.RemoveItemAsync("access_token");
				//await localStorage.RemoveItemAsync("refresh_token");

				// SessionStorageをクリア
				await SessionStorage.ClearAsync();

				// ログインページにリダイレクト
				NavigationManager.NavigateTo("/login", forceLoad: true);
			}
			catch (Exception ex)
			{
				Console.WriteLine($"ログアウトエラー: {ex.Message}");
			}
		}
	}

	protected override void OnInitialized()
	{
		appStateHandler = (_, e) =>
		{
			if (e.PropertyName == nameof(AppState.CurrentProjectName) || e.PropertyName == nameof(AppState.UserName))
			{
				InvokeAsync(StateHasChanged);
			}
		};

		AppState.PropertyChanged += appStateHandler;
	}

	public void Dispose()
	{
		if (appStateHandler is not null)
		{
			AppState.PropertyChanged -= appStateHandler;
		}
	}
}
